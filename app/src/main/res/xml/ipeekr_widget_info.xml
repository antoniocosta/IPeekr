<?xml version="1.0" encoding="utf-8"?>
<!--
  One widget, resizable from 1x1 to the whole screen in both directions.
  Default placement is 3x3 (targetCell* on Android 12+, minWidth/minHeight before that).
  configure + reconfigurable: long-press on the launcher offers the app as the widget's settings.
  configuration_optional: adding the widget doesn't open it (Android 12+).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:description="@string/widget_description"
    android:configure="net.uncorp.ipeekr.MainActivity"
    android:widgetFeatures="reconfigurable|configuration_optional" />
